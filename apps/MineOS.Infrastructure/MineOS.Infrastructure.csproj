<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MineOS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="8.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
  </ItemGroup>

  <!--
    Security floors for packages nothing here references directly. Each one
    arrives through a dependency above at a version the NuGet advisory feed
    flags as vulnerable, and a direct reference is the only way to lift it
    without waiting for the parent package to ship a new release. Drop an entry
    once its parent resolves to a fixed version on its own.

      SQLitePCLRaw.bundle_e_sqlite3   EntityFrameworkCore.Sqlite pins 2.1.6, and
                                      GHSA-2m69-gcr7-jv3q covers everything up
                                      to and including 2.1.11.
      System.Net.Http                 AspNetCore.DataProtection -> Win32.Registry
                                      -> Security.AccessControl -> the
                                      NETStandard.Library 1.6.1 meta-package,
                                      which still asks for the 4.3.0 facades.
                                      GHSA-7jgj-8wvc-jh57 covers < 4.3.4.
      System.Security.Cryptography.Xml  AspNetCore.DataProtection pins 8.0.2;
                                      the 8.0.x advisories run through 8.0.3.
      System.Text.RegularExpressions  Same NETStandard.Library 1.6.1 path as
                                      System.Net.Http. GHSA-cmhx-cq75-c4mj
                                      covers 4.3.0 only.
  -->
  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MineOS.Application\MineOS.Application.csproj" />
    <ProjectReference Include="..\MineOS.Domain\MineOS.Domain.csproj" />
  </ItemGroup>

</Project>
